{
  "name": "shihana-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "start": "node scripts/start.mjs",
    "preview": "node scripts/start.mjs --browser",
    "dev": "node scripts/dev.mjs",
    "doctor": "node scripts/task.mjs doctor",
    "ws:test": "node scripts/task.mjs ws-test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/hud/tsconfig.json"
  },
  "dependencies": {
    "ws": "https://registry.npmjs.org/ws/-/ws-8.23.0.tgz"
  },
  "devDependencies": {
    "typescript": "https://registry.npmjs.org/typescript/-/typescript-5.9.3.tgz",
    "@types/node": "https://registry.npmjs.org/@types/node/-/node-24.19.2.tgz",
    "esbuild": "https://registry.npmjs.org/esbuild/-/esbuild-0.28.2.tgz",
    "electron": "https://registry.npmjs.org/electron/-/electron-45.3.2.tgz",
    "playwright": "https://registry.npmjs.org/playwright/-/playwright-1.62.1.tgz"
  },
  "overrides": {
    "@electron-internal/extract-zip": "https://registry.npmjs.org/@electron-internal/extract-zip/-/extract-zip-1.0.8.tgz",
    "@electron/get": "https://registry.npmjs.org/@electron/get/-/get-5.1.0.tgz",
    "@esbuild/win32-x64": "https://registry.npmjs.org/@esbuild/win32-x64/-/win32-x64-0.28.2.tgz",
    "csstype": "https://registry.npmjs.org/csstype/-/csstype-3.2.3.tgz",
    "debug": "https://registry.npmjs.org/debug/-/debug-4.4.3.tgz",
    "env-paths": "https://registry.npmjs.org/env-paths/-/env-paths-3.0.0.tgz",
    "graceful-fs": "https://registry.npmjs.org/graceful-fs/-/graceful-fs-4.2.12.tgz",
    "ms": "https://registry.npmjs.org/ms/-/ms-2.1.3.tgz",
    "playwright-core": "https://registry.npmjs.org/playwright-core/-/playwright-core-1.62.1.tgz",
    "progress": "https://registry.npmjs.org/progress/-/progress-2.0.3.tgz",
    "scheduler": "https://registry.npmjs.org/scheduler/-/scheduler-0.28.0.tgz",
    "semver": "https://registry.npmjs.org/semver/-/semver-7.8.6.tgz",
    "sumchecker": "https://registry.npmjs.org/sumchecker/-/sumchecker-3.0.1.tgz",
    "undici-types": "https://registry.npmjs.org/undici-types/-/undici-types-8.9.0.tgz",
    "undici": "https://registry.npmjs.org/undici/-/undici-7.30.2.tgz"
  }
}